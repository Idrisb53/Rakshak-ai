# Supabase project configuration
# Copy this file to .env and replace placeholders with values from your own project.
# Never commit .env or any secret/admin key.

SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Leave unset unless trusted server-side code requires admin operations.
# NEVER use a service-role/secret key in VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=
